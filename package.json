{
  "name": "flowname",
  "version": "1.0.0",
  "type": "module",
  "description": "Analysis-guided joint JavaScript identifier recovery",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/product.test.mjs test/defensive.test.mjs test/concurrency.test.mjs test/rename-scopes.test.mjs test/playground.test.mjs test/edge-cases.test.mjs",
    "flowname": "node dist/product-cli.js",
    "prepack": "npm run build && node scripts/build-package.mjs",
    "playground": "npm run build:pages && node web/server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "npm run build:pages && node --test --test-isolation=none test/pages.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:edges": "npm run build && node --test --test-isolation=none test/edge-cases.test.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.0.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "main": "./package-dist/library.js",
  "types": "./package-dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/library.d.ts",
      "import": "./package-dist/library.js"
    },
    "./html": {
      "types": "./package-dist/html-reporter.d.ts",
      "import": "./package-dist/html-reporter.js"
    }
  },
  "bin": {
    "flowname": "./package-dist/product-cli.js"
  },
  "files": [
    "package-dist",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123wwwa/FlowName.git"
  },
  "homepage": "https://123wwwa.github.io/FlowName/",
  "bugs": {
    "url": "https://github.com/123wwwa/FlowName/issues"
  },
  "keywords": [
    "javascript",
    "identifier-recovery",
    "llm",
    "static-analysis",
    "variable-renaming"
  ],
  "license": "MIT"
}
