# Repository allowlist: product, tests, playground, release configuration only.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/tsconfig.json
!/README.md
!/LICENSE
!/docs/
/docs/*
!/docs/README.md
!/docs/approach.md
!/docs/limitations.md
!/docs/experiments.md
!/docs/guide.md
!/docs/architecture.md
!/docs/recovery-passes.md
!/docs/pass-cost-assessment.md
!/docs/relation-walkthrough.md
!/docs/jsimplifier-requests.md
!/src/
/src/*
!/src/analysis.ts
!/src/babel.ts
!/src/concurrency.ts
!/src/grouping.ts
!/src/html-reporter.ts
!/src/inference.ts
!/src/library.ts
!/src/passes.ts
!/src/lightweight.ts
!/src/product-cli.ts
!/src/provider-config.ts
!/src/rename.ts
!/src/request-budget.ts
!/src/types.ts
!/scripts/
/scripts/*
!/scripts/build-package.mjs
!/scripts/build-pages.mjs
!/scripts/test-package.mjs
!/test/
/test/*
!/test/product.test.mjs
!/test/defensive.test.mjs
!/test/concurrency.test.mjs
!/test/rename-scopes.test.mjs
!/test/playground.test.mjs
!/test/pages.test.mjs
!/web/
/web/*
!/web/index.html
!/web/app.js
!/web/style.css
!/web/server.mjs
!/web/options.js
!/web/browser-transport.js
!/web/browser-worker.js
!/web/browser-globals.js
!/web/browser-crypto.js
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/examples/
/examples/*
!/examples/offline-demo.mjs
# Never commit credentials, including nested environment files.
**/.env
**/.env.*
**/node_modules/
# Personal agent instructions stay local.
**/AGENTS.md
**/agents.md
**/agent.md
