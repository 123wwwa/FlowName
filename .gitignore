# Repository allowlist: product, tests, playground, release configuration only.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/tsconfig.json
!/README.md
!/AGENTS.md
!/src/
/src/*
!/src/analysis.ts
!/src/babel.ts
!/src/concurrency.ts
!/src/grouping.ts
!/src/html-reporter.ts
!/src/inference.ts
!/src/library.ts
!/src/lightweight.ts
!/src/product-cli.ts
!/src/provider-config.ts
!/src/rename.ts
!/src/request-budget.ts
!/src/types.ts
!/scripts/
/scripts/*
!/scripts/build-package.mjs
!/test/
/test/*
!/test/product.test.mjs
!/test/defensive.test.mjs
!/test/concurrency.test.mjs
!/test/rename-scopes.test.mjs
!/test/playground.test.mjs
!/web/
/web/*
!/web/index.html
!/web/app.js
!/web/style.css
!/web/server.mjs
!/web/worker.mjs
!/examples/
/examples/*
!/examples/offline-demo.mjs
# Never commit credentials, including nested environment files.
**/.env
**/.env.*
**/node_modules/
